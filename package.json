{
  "name": "avinashs-kingdom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:share": "KINGDOM_SHARE=1 vite --host 0.0.0.0",
    "dev:full": "concurrently -k \"npm run dev:api\" \"vite\"",
    "dev:api": "node scripts/orchestrator-api.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/lib/*.test.mjs",
    "sync": "node scripts/sync-kingdom.mjs",
    "sync:audits": "node scripts/sync-kingdom.mjs",
    "sync:dry-run": "node scripts/sync-kingdom.mjs --dry-run",
    "test:venture": "node scripts/run-venture-tests.mjs",
    "orchestrator:open": "node scripts/orchestrator-open.mjs",
    "tunnels": "bash scripts/cloudflare-dashboards.sh",
    "tunnels:list": "bash scripts/cloudflare-dashboards.sh --list",
    "share": "bash scripts/share-orchestrator.sh",
    "share:health": "bash scripts/share-health.sh",
    "share:named": "bash scripts/named-tunnel-run.sh",
    "share:named-setup": "bash scripts/named-tunnel-setup.sh",
    "git:inventory": "node scripts/git-inventory.mjs",
    "dashboards": "bash scripts/start-dashboards.sh",
    "dashboards:status": "bash scripts/start-dashboards.sh --status",
    "dashboards:stop": "bash scripts/start-dashboards.sh --stop",
    "brain:lint": "node brain/harness/lint.mjs",
    "brain:query": "node brain/harness/wiki-query.mjs",
    "brain:ingest": "node brain/harness/ingest.mjs",
    "brain:harness": "node brain/harness/query.mjs",
    "venture:new": "node scripts/new-venture.mjs",
    "headroom:start": "bash scripts/headroom-kingdom.sh start",
    "headroom:stop": "bash scripts/headroom-kingdom.sh stop",
    "headroom:status": "bash scripts/headroom-kingdom.sh status",
    "headroom:setup": "bash scripts/headroom-kingdom.sh setup-print"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
